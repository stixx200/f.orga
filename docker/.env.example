POSTGRES_PASSWORD=please-change
# Password of the database role of the application (forga_app, no superuser; docker/db/10-app-role.sh)
FORGA_DB_APP_PASSWORD=please-change-app
# Behind Caddy (profile https / https-internal) only on the host: FORGA_PORT=127.0.0.1:8080
FORGA_PORT=8080
# production (real data) or test (demo data only); docker/compose.stages.yml sets it per system
FORGA_STAGE=production
# Setup token for the first start (optional; otherwise a random token is printed to the log)
FORGA_SETUP_TOKEN=
# Address of f.orga as users open it (https://…), for e-mail links and OIDC; with https:// cookies are sent only encrypted
FORGA_PUBLIC_URL=
# Reverse proxy in front of f.orga whose X-Forwarded-For/-Proto is believed: uniquelocal (Caddy of this compose file),
# a number of proxies or addresses. Required behind a proxy, otherwise the login lock after failed passwords locks a
# username for everybody and HTTPS is not recognised. Never set without a proxy (addresses could be forged).
FORGA_TRUST_PROXY=
# HTTPS with Caddy: host name and certificate (e-mail address = Let's Encrypt; "/certs/forga.crt /certs/forga.key" =
# own certificate in FORGA_CERT_DIR); profile https-internal uses Caddy's internal certificate authority instead
FORGA_DOMAIN=
FORGA_TLS=
FORGA_CERT_DIR=./certs
# Public keys of trusted plugin publishers (npm run plugin -- keygen), comma separated
FORGA_PLUGIN_KEYS=
# Server key (32 bytes, Base64: openssl rand -base64 32); encrypts the device keys of the info terminals and keys the
# HMAC of the driving licence stickers (after a change the stickers have to be registered again).
# Required for the module info-terminal and for scheduled backups (it encrypts the stored backup passphrase).
# Changing it makes existing terminal links unshowable (devices keep working); the backup passphrase must be entered again.
# Keep it in the password safe, apart from the backups: backups do not contain it.
FORGA_SECRET_KEY=
# Folder on the host for the backups of the module backup (mounted as /backups, owned by UID 1000), e.g. a NAS mount.
# Empty: a Docker volume (forga-backups). docker/backup.sh stays for backups of the whole server.
FORGA_BACKUP_DIR=
# Name of this installation in the file names of its backups
FORGA_INSTANCE=forga

# Two systems side by side (docker/compose.stages.yml): real data and demo data, each with its own database
POSTGRES_PASSWORD_REAL=please-change
POSTGRES_PASSWORD_TEST=please-change-too
FORGA_DB_APP_PASSWORD_REAL=please-change-app-real
FORGA_DB_APP_PASSWORD_TEST=please-change-app-test
# Setup tokens for the first start of each system (optional; otherwise a random token is printed to the log)
FORGA_SETUP_TOKEN_REAL=
FORGA_SETUP_TOKEN_TEST=
# Server keys of the two systems (openssl rand -base64 32), one each
FORGA_SECRET_KEY_REAL=
FORGA_SECRET_KEY_TEST=
# Addresses of the two systems (https://…), if served via HTTPS
FORGA_PUBLIC_URL_REAL=
FORGA_PUBLIC_URL_TEST=
# Backup folders on the host for the two systems, apart from each other (empty: Docker volumes forga_real_backups,
# forga_test_backups). Scheduled backups of the test system: FORGA_BACKUP_SCHEDULER_TEST=on
FORGA_BACKUP_DIR_REAL=
FORGA_BACKUP_DIR_TEST=
FORGA_BACKUP_SCHEDULER_TEST=off
FORGA_REAL_PORT=8080
FORGA_TEST_PORT=8081
