{
  "name": "@forga/image",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:ops", "type:image"],
  "release": {
    "docker": {
      "repositoryName": "stixx200/f.orga"
    }
  },
  "targets": {
    "docker:build": {
      "cache": false,
