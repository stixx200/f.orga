{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["*.mts", "../apps/server/src/**/*.ts", "../libs/*/*/src/**/*.ts", "../modules/*/*/src/**/*.ts"]
}
