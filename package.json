{
  "name": "@forga/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint --deny-warnings && node tools/module-boundaries.mjs",
    "typecheck": "nx run-many -t typecheck && node tools/typecheck-sources.mjs",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "integration": "nx run-many -t integration",
    "plugin": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/plugin.mts",
    "backup": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/backup.mts",
    "migration:create": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/migration.mts create",
    "migration:run": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/migration.mts run",
    "migration:reset": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/migration-reset.mts",
    "dev": "nx run-many -t serve --parallel=20",
    "seed": "tsx --conditions=@forga/source --tsconfig tools/tsconfig.json tools/seed.mts",
    "e2e": "nx run-many -t e2e --parallel=1",
    "e2e:fresh": "tsx --tsconfig tools/tsconfig.json tools/e2e.mts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run integration && pnpm run build"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "nx",
      "unrs-resolver"
    ]
  },
