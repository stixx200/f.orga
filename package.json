    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.2",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "24.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.8.1",
    "react-refresh": "~0.14.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
