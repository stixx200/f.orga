{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.{js,ts,mjs,mts,cjs,cts}",
      "!{projectRoot}/vite.config.{js,ts,mjs,mts,cjs,cts}",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/rspack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "serveStaticTargetName": "serve-static",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build",
          "cwd": ".",
          "args": ["-f docker/Dockerfile", "--tag forga:local"]
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    }
  ],
  "release": {
    "projectsRelationship": "fixed",
    "projects": ["*", "!*-e2e"],
    "releaseTag": {
      "pattern": "v{version}"
    },
    "changelog": {
      "workspaceChangelog": true,
      "projectChangelogs": false
    },
    "docker": {
      "registryUrl": "ghcr.io",
      "versionSchemes": {
        "production": "{versionActionsVersion}"
      },
      "preVersionCommand": "pnpm exec nx run @forga/image:\"docker:build\""
    }
  },
  "analytics": false,
  "targetDefaults": {
    "build": {
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "integration": {
      "cache": true,
      "inputs": ["default", "^production", { "env": "TEST_DATABASE_URL" }]
    },
    "e2e-ci--**/**": {
      "dependsOn": [
        "...",
        {
          "projects": ["@forga/server", "shell", "tag:type:web"],
          "target": "build"
        }
      ],
      "inputs": [
        "...",
        "{workspaceRoot}/e2e/**/*",
        "{workspaceRoot}/tools/e2e-serve.mts",
        "{workspaceRoot}/tools/tsconfig.json",
        { "env": "FORGA_E2E_URL" },
        { "env": "FORGA_E2E_DATABASE_URL" },
        { "env": "FORGA_E2E_PORT" },
        { "env": "FORGA_TOTP_FILE" },
        { "env": "FORGA_TOTP_USED_FILE" },
        { "env": "FORGA_PG_BIN" },
        { "env": "FORGA_E2E_BOOT" },
        { "env": "FORGA_E2E_KEEP" }
      ],
      "outputs": [
        "...",
        "{workspaceRoot}/dist/e2e",
        "{workspaceRoot}/dist/e2e-results/{projectName}",
        "{workspaceRoot}/dist/e2e-report/{projectName}"
      ]
    }
  },
  "generators": {
    "@nx/react": {
      "library": {
        "unitTestRunner": "none"
      }
    }
  },
  "nxCloudId": "6ae652827664ae007bc7c1db"
}
