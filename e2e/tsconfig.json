{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "support/**/*.ts",
    "playwright.base.ts",
    "forga-e2e/**/*.ts",
    "../apps/shell-e2e/**/*.ts",
    "../libs/core/core-e2e/**/*.ts",
    "../modules/*/*-e2e/**/*.ts"
  ]
}
