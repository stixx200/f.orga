{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "target": "es2023",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../duty-officer/duty-officer-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../training/training-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../masterdata/masterdata-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../incidents/incidents-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/core/core-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/core/core-api/tsconfig.lib.json"
    },
    {
      "path": "../compensation-contracts/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vitest.config.mts",
    "vitest.config.ts"
  ]
}
