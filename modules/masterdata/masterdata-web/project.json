{
  "name": "masterdata-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/masterdata/masterdata-web/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "modules/masterdata/masterdata-web"
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "shell:serve"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "modules/masterdata/masterdata-web"
      }
    },
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  },
  "tags": [
    "scope:module-masterdata",
    "type:web"
  ]
}
